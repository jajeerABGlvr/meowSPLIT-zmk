#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC         &kp NUMBER_1  &kp NUMBER_2  &kp N3    &kp N4    &kp N5                                &kp N6         &kp N7    &kp N8     &kp N9     &kp N0    &kp MINUS
&kp TAB         &kp Q         &kp W         &kp E     &kp R     &kp T                                 &kp Y          &kp U     &kp I      &kp O      &kp P     &kp EQUAL
&kp LEFT_SHIFT  &kp A         &kp S         &kp D     &kp F     &kp G                                 &kp H          &kp J     &kp K      &kp L      &kp SEMI  &kp APOS
&kp LCTRL       &kp Z         &kp X         &kp C     &kp V     &kp B                                 &kp N          &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                              &to 1         &kp LALT  &kp LGUI  &kp LEFT_SHIFT  &kp SPACE  &kp ENTER  &kp BACKSPACE  &kp LGUI  &kp RALT   &kp RCTRL
            >;
        };

        upper {
            bindings = <
&kp GRAVE       &kp F1  &kp F2    &kp F3     &kp F4    &kp F5                    &kp F6   &kp F7    &kp F8    &kp F9     &kp F10           &kp EQUAL
&kp TAB         &kp Q   &kp W     &kp E      &none     &none                     &kp F11  &kp F12   &kp UP    &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S     &kp D      &none     &none                     &none    &kp LEFT  &kp DOWN  &kp RIGHT  &none             &none
&kp LCTRL       &none   &none     &none      &none     &none                     &none    &none     &none     &none      &none             &none
                        &kp LEFT  &kp RIGHT  &kp DOWN  &kp UP  &kp SPACE  &none  &to 0    &none     &none     &none
            >;
        };
    };
};
